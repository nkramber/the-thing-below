# IDE
.idea/
.vscode/

# The local settings of the harness on one machine. It can hold hooks and permissions, so the
# review gate refuses it under the label too (D-700, D-1085).
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Local run records and logs
logs/
artifacts/
*.log

# .NET build output
bin/
obj/

# The local outputs of a spike, such as the Sprite Fusion test (D-620). A spike branch holds
# the files of a spike that the project keeps.
spike/

# Godot editor output. The editor writes a backup of the project file when it changes it.
.godot/
*.csproj.old
