<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- Game is the Godot project. It draws Core state and turns input into intents (D-99, D-100). -->
  <PropertyGroup>
    <!--
      The Godot editor writes a target framework into this file when the file has none, and
      Godot 4.7.2 writes `net8.0`. The project pins `net10.0` here, which D-99 sets, so the
      editor leaves the value alone (F-60).
    -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TheThingBelow.Game</RootNamespace>
    <AssemblyName>TheThingBelow.Game</AssemblyName>
    <!-- The Godot source generators emit code that the documentation rule cannot cover. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TheThingBelow.Core/TheThingBelow.Core.csproj" />
  </ItemGroup>

  <!--
    The Godot export walks the project folder alone, and `content/` lies outside it (F-42).
    Thus the assembly carries every content file as a resource, and Game reads the bytes from
    its own assembly in the editor and in every export (D-508).

    `%(RecursiveDir)` holds the separator of the build machine, and Windows gives `\`. The
    replacement below makes one set of resource names on every platform, so the embedded set
    and the folder match on each CI leg (T-7).
  -->
  <ItemGroup>
    <EmbeddedResource Include="../content/**/*.json">
      <LogicalName>content/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
