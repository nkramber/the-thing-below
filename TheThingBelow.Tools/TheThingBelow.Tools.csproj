<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tools holds the gate tools and the content tools (D-101, D-496, D-497). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TheThingBelow.Tools</RootNamespace>
    <AssemblyName>TheThingBelow.Tools</AssemblyName>
  </PropertyGroup>

  <!--
    The `det-lint` command reads C# through the Roslyn compiler library, and it checks the
    type that the compiler gives each expression (D-498, F-38). Version 5.9.0 of 2026-08-17
    is the newest release of the package, read on NuGet on 2026-09-17.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <!--
    The `replay-identity` command computes the state hash of every run of the identity set,
    so it calls Core. Core references no project, and every other project can reference it
    (G-1, D-100, D-504).
  -->
  <ItemGroup>
    <ProjectReference Include="../TheThingBelow.Core/TheThingBelow.Core.csproj" />
  </ItemGroup>

</Project>
