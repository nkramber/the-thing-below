#!/bin/sh
# The pre-commit hook of the repository. `make hooks` sets the hook path (D-8, D-25).
#
# It refuses a commit on `main`, and it runs the STE checker on the staged documents
# (D-10, D-585). A finding stops the commit.

set -e

# `symbolic-ref` reads the branch of a checkout that holds no commit yet.
branch=$(git symbolic-ref --quiet --short HEAD || echo "")
if [ -z "$branch" ]; then
    echo "pre-commit: this checkout has no branch. Make a branch, then commit again (D-8)." >&2
    exit 1
fi

if [ "$branch" = "main" ]; then
    echo "pre-commit: this checkout is on main. Every change starts on a branch (D-8, D-25)." >&2
    echo "pre-commit: make a branch named <prefix>/pr-<n>-<slug>, then commit again." >&2
    exit 1
fi

# The four exempt paths are dated records, and the checker never reads them (D-10).
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' |
    grep -v -e '^docs/reviews/' -e '^docs/session-handoff' -e '^docs/archive/' || true)

if [ -z "$files" ]; then
    exit 0
fi

if ! python3 docs/tools/ste-check.py $files; then
    echo "pre-commit: the STE checker found a fault. Correct it, then commit again (G-12)." >&2
    exit 1
fi
